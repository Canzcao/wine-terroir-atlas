data/collection-progress.json
data/country-rotation.json

# ---- 临时故障产物（当日坏图快照，仅供本机排查）----
*.broken-*.json

# ---- 一次性迁移/本机专用脚本（含本机绝对路径，不入库）----
scripts/_fix-mac-paths.py
.pre-paths-migration/

# ---- Python 缓存 ----
__pycache__/
*.pyc

# ---- 系统 ----
.DS_Store
Thumbs.db
*.swp
*~

# ---- 编辑器 ----
.idea/
.vscode/
*.code-workspace
